# Set this to the exact StepFun gateway URL supplied by TSecBench.
# Do not infer the gateway URL from another team's DeepSeek configuration.
LLM_BASE_URL=
LLM_MODEL=step-5-preview
STEPFUN_API_KEY=
LLM_REASONING_EFFORT=high
LLM_MAX_OUTPUT_TOKENS=512
LLM_REQUEST_TIMEOUT=60
# BENCHMARK_BASE_URL and BENCHMARK_TOKEN are injected by TSecBench.
